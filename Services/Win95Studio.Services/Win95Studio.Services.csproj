<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Win95Studio.Services</RootNamespace>
  </PropertyGroup>

  <!-- Down the stack only. Services may use Models; nothing here may reach up into the
       Companion web project, which is what keeps "start After Effects" callable from a test or
       a CLI without an HTTP request in the way. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Models\Win95Studio.Models\Win95Studio.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <!-- Abstractions only, not the full Configuration package: this project reads an
         IConfiguration it is handed, it never builds one. ConfigurationExtensions is what adds
         the services.Configure<T>(IConfigurationSection) overload the composition root uses. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

</Project>
